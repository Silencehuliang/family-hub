// ../../../workers/api/src/modules/auth/rateLimit.ts
async function recordPinFail(kv, memberId) {
  const key = `${FAIL_PREFIX}${memberId}`;
  const nowSec = Math.floor(Date.now() / 1e3);
  const counter = await kv.get(key, "json");
  let count = 1;
  if (counter && nowSec - counter.windowStart < PIN_LIMIT.WINDOW_SECONDS) {
    count = counter.count + 1;
  }
  await kv.put(key, JSON.stringify({ count, windowStart: nowSec }), {
    expirationTtl: PIN_LIMIT.WINDOW_SECONDS
  });
  if (count >= PIN_LIMIT.MAX_ATTEMPTS) {
    await kv.put(`${LOCK_PREFIX}${memberId}`, "1", {
      expirationTtl: PIN_LIMIT.LOCK_SECONDS
    });
    return 0;
  }
  return PIN_LIMIT.MAX_ATTEMPTS - count;
}
async function clearPinFail(kv, memberId) {
  await kv.delete(`${FAIL_PREFIX}${memberId}`);
  await kv.delete(`${LOCK_PREFIX}${memberId}`);
}
async function isPinLocked(kv, memberId) {
  const locked = await kv.get(`${LOCK_PREFIX}${memberId}`);
  return locked !== null;
}
var FAIL_PREFIX, LOCK_PREFIX;
var init_rateLimit = __esm({
  "../../../workers/api/src/modules/auth/rateLimit.ts"() {
    "use strict";
    init_functionsRoutes_0_4753862343509565();
    init_src();
    FAIL_PREFIX = "pinfail:";
    LOCK_PREFIX = "pinlock:";
    __name(recordPinFail, "recordPinFail");
    __name(clearPinFail, "clearPinFail");
    __name(isPinLocked, "isPinLocked");
  }
});

