      }
      /** 根据周期计算下一个日期 */
      advanceDate(dateStr, cycle) {
        const d = new Date(dateStr);
        switch (cycle) {
          case "daily":
            d.setDate(d.getDate() + 1);
            break;
          case "weekly":
            d.setDate(d.getDate() + 7);
            break;
          case "monthly":
            d.setMonth(d.getMonth() + 1);
            break;
          case "yearly":
            d.setFullYear(d.getFullYear() + 1);
            break;
        }
        return d.toISOString().slice(0, 10);
      }
